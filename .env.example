# ---------------------------------------------------------------------------
# Atrium — local environment. Copy to .env for `docker compose up`.
# Nothing here is a real secret; production values are set in the host's env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=atrium
POSTGRES_PASSWORD=atrium
POSTGRES_DB=atrium
DATABASE_URL=postgres://atrium:atrium@postgres:5432/atrium

# --- API ------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=debug
# Minimum 16 characters — the process refuses to boot otherwise (config/env.ts).
# Render generates this per-environment; it is never committed.
JWT_SECRET=dev-only-not-a-real-secret-min-16-chars
JWT_ACCESS_TTL=900              # access token lifetime, seconds

# pg pool size per replica. Three replicas share postgres max_connections=200.
PG_POOL_MAX=20

# Apply migrations during boot, before the server binds.
# Leave false for docker compose: the one-shot `migrate` service handles it, and
# three replicas each migrating on boot would race. Render sets it true because
# its free tier has no pre-deploy hook and runs a single instance.
RUN_MIGRATIONS_ON_BOOT=false

# Booking rules (brief §04 "Operating Rules"; see ARCHITECTURE.md Assumption 1)
HOLD_TTL_SECONDS=480                # 8 minutes
CHECKOUT_REARM_SECONDS=600          # 10 minutes guaranteed from checkout
MAX_HOLD_REARMS=2                   # re-arm permitted at most twice
MAX_HOLD_LIFETIME_SECONDS=1800      # 30 minutes absolute cap on hold life
ROOM_TURNAROUND_MINUTES=15
HOLD_SWEEPER_INTERVAL_SECONDS=15

# --- Paygate --------------------------------------------------------------
PAYGATE_PORT=9000
PAYGATE_BASE_URL=http://paygate:9000
PAYGATE_SECRET=dev-paygate-hmac-secret
PAYGATE_CHAOS=on
# The brief's spelling. Paygate accepts PAYGATE_WEBHOOK_URL as an alias, but
# CALLBACK wins and is the one compose sets.
PAYGATE_CALLBACK_URL=http://nginx:8080/webhooks/paygate
# Fixed seed, so a chaotic run can be replayed decision for decision.
PAYGATE_SEED=atrium-local
PAYGATE_TIMEOUT_MS=8000

# How often each replica drains unapplied webhook deliveries.
WEBHOOK_DRAIN_INTERVAL_SECONDS=10
# How long an accepted-but-unresolved charge or refund waits for a webhook
# before the API asks the provider directly. A delivery refused while a replica
# was restarting is lost for good — Paygate never retries one.
# CHARGE must stay well below HOLD_TTL_SECONDS.
CHARGE_POLL_AFTER_SECONDS=100
REFUND_POLL_AFTER_SECONDS=45
# Re-runs of a transaction Postgres threw away with a class-40 error. See
# ARCHITECTURE.md Appendix B for why this is small.
TRANSIENT_RETRY_ATTEMPTS=3

# --- Web ------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Load balancer --------------------------------------------------------
NGINX_PORT=8080

# --- Local only -----------------------------------------------------------
# Host port for postgres, so psql can reach it from outside compose.
POSTGRES_PORT=5432
